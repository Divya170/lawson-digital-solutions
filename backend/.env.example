# API port
PORT=4000
# Origin of the Next.js site (used for CORS when the frontend calls the API directly)
FRONTEND_ORIGIN=http://localhost:3000
# SQLite file (defaults to ../database/app.sqlite)
# DATABASE_PATH=../database/app.sqlite
# Folder for staff image uploads (defaults to ./uploads)
# UPLOAD_DIR=./uploads
# JWT secret for staff sessions — CHANGE THIS in production
JWT_SECRET=change-me-to-a-long-random-string
# Staff account created on first run (only if no staff user exists)
STAFF_EMAIL=admin@lawsondigital.dev
STAFF_PASSWORD=Lawson@2026
STAFF_NAME=Rhett Lawson
